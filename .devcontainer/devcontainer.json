{
  "name": "longeval-cli",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
  },
  "initializeCommand": "mkdir -p ${HOME}/.tira",
  "privileged": true,
  "mounts": [
    "source=/tmp,target=/tmp,type=bind",
    "source=${localEnv:HOME}/.tira,target=/home/vscode/.tira,type=bind"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
      }
    }
  }
}
